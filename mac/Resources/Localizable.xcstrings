          }
        }
      }
    },
    "handsfree.copyURL": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy URL action"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "URL 동작 복사"
          }
        }
      }
    },
    "handsfree.onboarding.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: pair macOS Vocal Shortcuts (\"Hey Sunday\" / \"헤이 선데이\") with Send by voice on Apple Silicon Macs."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항: Apple Silicon Mac에서 macOS 음성 단축어(\"Hey Sunday\" / \"헤이 선데이\")를 연결해 손대지 않고 받아쓰기를 시작해 보세요."
          }
        }
      }
    },
    "handsfree.onboarding.button": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정하기"
          }
        }
      }
    },
    "handsfree.onboarding.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hands-free start with your voice"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성으로 바로 시작·전송"
          }
        }
      }
    },
    "handsfree.openSendByVoice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure send phrases →"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송 명령어 설정 →"
          }
        }
      }
    },
    "handsfree.openSettings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Vocal Shortcuts"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 단축어 열기"
          }
        }
      }
    },
    "handsfree.phrases.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can register any phrase in macOS Vocal Shortcuts. These short two-word phrases are easy to trigger and rarely misfire."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 음성 단축어에서는 원하는 문구를 자유롭게 등록할 수 있어요. 아래처럼 짧고 또렷한 문구를 추천해요."
          }
        }
      }
    },
    "handsfree.phrases.copied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied \"%@\" to the clipboard."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" 문구를 클립보드에 복사했어요."
          }
        }
      }
    },
    "handsfree.phrases.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggested wake phrases"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추천 호출 문구"
          }
        }
      }
    },
    "handsfree.privacyNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS listens on-device for your Vocal Shortcut and controls the orange mic indicator. Sunday Voice only starts recording after the shortcut triggers."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호출 문구 감지와 주황색 마이크 표시등은 macOS가 이 Mac 안에서 직접 처리해요. Sunday Voice는 음성 단축어가 실행된 뒤에만 받아쓰기를 시작해요."
          }
        }
      }
    },
    "handsfree.step1.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click \"Open Vocal Shortcuts\" above (or open System Settings → Accessibility → Speech → Vocal Shortcuts) and click Set Up."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위 \"음성 단축어 열기\" 버튼을 누르거나 시스템 설정 → 손쉬운 사용 → 말하기 → 음성 단축어에서 설정을 시작해 주세요."
          }
        }
      }
    },
    "handsfree.step1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Accessibility → Vocal Shortcuts"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용 → 음성 단축어 열기"
          }
        }
      }
    },
    "handsfree.step2.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick \"Start Dictation\" under Sunday Voice. If it does not appear yet, create a Shortcut with \"Open URLs\" using the link below and pick that Shortcut."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunday Voice의 \"받아쓰기 시작\" 동작을 선택해 주세요. 목록에 보이지 않으면 단축어 앱에서 아래 주소로 \"URL 열기\" 단축어를 만들어 연결할 수 있어요."
          }
        }
      }
    },
    "handsfree.step2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Start Dictation (or URL action)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"받아쓰기 시작\" 동작 선택 (또는 URL 단축어)"
          }
        }
      }
    },
    "handsfree.step3.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say \"Hey Sunday\" or \"헤이 선데이\" clearly three times. macOS trains and detects the phrase entirely on this Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Hey Sunday\" 또는 \"헤이 선데이\"를 또렷하게 세 번 말해 주세요. macOS가 이 Mac 안에서만 온디바이스로 학습하고 감지해요."
          }
        }
      }
    },
    "handsfree.step3.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record your wake phrase 3 times"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호출 문구를 3번 말해 등록하기"
          }
        }
      }
    },
    "handsfree.step4.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say your phrase anywhere your cursor is blinking. Pause about 2 seconds to paste, or finish with \"send it\" / \"입력완료\" / \"보내기\" to paste and press Enter in chat apps."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커서가 깜빡이는 곳 어디서나 호출 문구를 말하면 받아쓰기가 시작돼요. 2초 정도 멈추면 붙여넣기만 하고, 끝에 \"입력완료\"·\"보내기\"·\"send it\"을 붙이면 채팅 앱에서 전송까지 해 줘요."
          }
        }
      }
    },
    "handsfree.step4.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak, then send by voice or pause"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말한 뒤 말로 전송하거나 잠깐 멈추기"
          }
        }
      }
    },
    "handsfree.steps.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up with Apple Vocal Shortcuts"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 음성 단축어 설정 방법"
          }
        }
      }
    },
    "handsfree.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start dictation at your current cursor with Apple Vocal Shortcuts, then finish with a send phrase — no keys needed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 음성 단축어로 현재 커서에서 바로 받아쓰기를 시작하고, 끝맺음 말로 전송까지 손을 대지 않고 마칠 수 있어요."
          }
        }
      }
    },
    "handsfree.test.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say your Vocal Shortcut phrase now, or click \"Test it\" below to verify cursor dictation right inside this box."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등록한 음성 단축어 문구를 말해 보거나, 아래 \"테스트하기\" 버튼을 눌러 이 상자에 바로 받아써지는지 확인해 보세요."
          }
        }
      }
    },
    "handsfree.test.button": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test it"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테스트하기"
          }
        }
      }
    },
    "handsfree.test.clear": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지우기"
          }
        }
      }
    },
    "handsfree.test.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your spoken test text will appear here…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 테스트 받아쓰기 결과가 나타나요…"
          }
        }
      }
    },
    "handsfree.test.received": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Triggered"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호출 확인됨"
          }
        }
      }
    },
    "handsfree.test.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test it"
          }
        },
