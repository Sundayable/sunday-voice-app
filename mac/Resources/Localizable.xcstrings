    "settings.recentContext.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you just said \"Sundayable\", the next sentence spells it the same way. Kept in memory and sent only with the next cloud request."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금 'Sundayable'이라고 말했다면 다음 문장에도 같은 표기를 써요. 메모리에만 잠시 두고 다음 클라우드 요청에만 함께 보내요."
          }
        }
      }
    },
    "settings.recentContext.localDisabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available only in Pro (Cloud) mode. Off while using Free Local Mode."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro (클라우드) 모드에서만 쓸 수 있어요. 무료 로컬 모드에서는 꺼져 있어요."
          }
        }
      }
    },
    "settings.screenContext": {
