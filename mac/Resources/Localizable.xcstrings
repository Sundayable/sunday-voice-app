            "value": "Offline local dictation (Free, no cloud APIs)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 로컬 받아쓰기 (무료 · 외부 API 없음)"
          }
        }
      }
    },
    "settings.localDictation.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribes on this Mac using Whisper large-v3-turbo and your local replacements with zero cloud calls. Uses the same local speech model as Meetings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외부 서버 호출 없이 이 Mac의 Whisper large-v3-turbo와 로컬 치환 사전으로 받아써요. 미팅용 로컬 음성 모델을 함께 사용해요."
          }
        }
      }
    },
    "settings.localDictation.setup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
