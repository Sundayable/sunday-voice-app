    },
    "settings.proFeature.wordsBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free Local Mode uses on-device speech recognition without an account. Pro unlocks synced custom vocabulary."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 로컬 모드는 계정 없이도 기기 내 음성 인식으로 작동해요. Pro에서는 동기화되는 나만의 단어장을 쓸 수 있어요."
          }
        }
      }
    },
    "settings.proFeature.wordsTitle": {
      "localizations": {
        "en": {
