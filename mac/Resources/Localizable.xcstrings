    "dictation.discardRecovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete recovery audio…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 음성 삭제…"
          }
        }
      }
    },
    "dictation.discardRecovery.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes unfinished dictation audio and partial text from this Mac now. Recent transcripts and meeting files are kept. Unfinished items are also deleted automatically after 7 days."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료되지 않은 받아쓰기 음성과 일부 텍스트를 이 Mac에서 지금 완전히 지워요. 최근 받아쓰기와 회의 파일은 그대로 남아요. 완료되지 않은 항목은 7일이 지나면 자동으로 지워져요."
          }
        }
      }
    },
    "dictation.discardRecovery.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete audio"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 삭제"
          }
        }
      }
    },
    "dictation.discardRecovery.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not delete recovery audio. Finish dictation and try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 음성을 삭제하지 못했습니다. 받아쓰기를 마친 뒤 다시 시도해 주세요."
          }
        }
      }
    },
