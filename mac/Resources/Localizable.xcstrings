    "vocab.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names, brands and terms you use. The top ones help recognition; known mis-hearings get fixed to your spelling."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 쓰는 이름·브랜드·용어예요. 상위 단어는 받아쓰기 힌트로 쓰고, 자주 틀리게 들리는 형태는 내 표기로 고쳐요."
          }
        }
      }
    },
