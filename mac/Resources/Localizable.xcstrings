    "dictation.discardRecovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete recovery audio…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 음성 삭제…"
          }
        }
