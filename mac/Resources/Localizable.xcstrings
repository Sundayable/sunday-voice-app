    "settings.proFeature.voiceBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free Local Mode transcribes cleanly on this Mac without an account. Pro unlocks custom writing-style cards."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 로컬 모드는 계정 없이도 이 Mac에서 깔끔하게 받아써요. Pro에서는 나만의 문체 스타일 카드를 만들 수 있어요."
          }
        }
      }
    },
    "settings.proFeature.voiceTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personal voice cards are a Pro feature"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 말투 학습은 Pro 기능이에요"
          }
        }
