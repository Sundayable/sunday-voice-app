    "ob.welcome.local.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs offline on this Mac with no account needed. Downloads a one-time ~660 MB speech model in the background, and nothing leaves your Mac unless you opt in to anonymous usage stats."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 없이 이 Mac에서 오프라인으로 작동해요. 처음 한 번 백그라운드에서 약 660 MB 음성 모델을 다운로드하며, 익명 사용 통계에 동의하지 않는 한 어떤 데이터도 Mac 밖으로 나가지 않아요."
          }
        }
      }
    },
    "ob.welcome.local.title": {
      "localizations": {
