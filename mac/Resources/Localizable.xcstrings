    "settings.recentContext": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use recent dictations for context"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금 말한 내용 참고하기"
          }
        }
