    "settings.screenContext.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If \"Vercel\" is on screen, it writes \"Vercel\" instead of guessing the spelling. Password fields are never read."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면에 'Vercel'이 보이면 소리 나는 대로 적지 않고 'Vercel'로 맞춰 써요. 비밀번호 입력란은 절대 읽지 않아요."
          }
        }
      }
    },
