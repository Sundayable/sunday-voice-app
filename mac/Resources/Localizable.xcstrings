    "dictation.discardRecovery.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes unfinished dictation audio and its partial text from this Mac. Recent transcripts and meeting files are kept."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에 저장된 미완료 받아쓰기 음성과 부분 텍스트를 삭제합니다. 삭제한 음성은 복구할 수 없습니다. 최근 받아쓰기와 회의 파일은 유지됩니다."
          }
        }
      }
    },
    "dictation.discardRecovery.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete audio"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 삭제"
          }
        }
      }
    },
    "dictation.discardRecovery.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not delete recovery audio. Finish dictation and try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 음성을 삭제하지 못했습니다. 받아쓰기를 마친 뒤 다시 시도해 주세요."
          }
        }
      }
    },
