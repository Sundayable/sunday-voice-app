    "setup.allowButton": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open permission settings"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한 설정 열기"
          }
        }
