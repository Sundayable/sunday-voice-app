          }
        }
      }
    },
    "settings.localDictation.signedOutBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active by default while signed out. Sign in with Google under Account to switch to Pro cloud dictation."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그아웃 상태에서는 무료 로컬 모드가 기본이에요. 계정 탭에서 Google로 로그인하면 Pro 클라우드 모드를 쓸 수 있어요."
          }
        }
      }
    },
