    "ob.welcome.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a key, talk in Korean, English or both, let go. The text lands where your cursor is — cleaned up, or in natural English."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 누른 채 한국어든 영어든 섞어서 말하고 놓으세요. 커서가 있는 곳에 깔끔하게, 또는 자연스러운 영어로 들어가요."
          }
        }
      }
    },
    "ob.welcome.fine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup takes about two minutes. You can switch between Free and Pro anytime in Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정은 2분 정도 걸려요. 무료와 Pro는 설정에서 언제든 바꿀 수 있어요."
          }
        }
      }
    },
