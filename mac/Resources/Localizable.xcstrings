    "ob.welcome.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a key, talk in Korean, English or both, let go. The text lands where your cursor is — cleaned up, or in natural English."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 누른 채 한국어든 영어든 섞어서 말하고 놓으세요. 커서가 있는 곳에 깔끔하게, 또는 자연스러운 영어로 들어가요."
          }
        }
      }
    },
