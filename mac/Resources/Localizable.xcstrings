    "settings.recentContext": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use recent dictations as context"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 받아쓰기를 맥락으로 사용"
          }
        }
      }
    },
    "settings.recentContext.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your last few dictations and your fixes to them help recognise the next one. They stay on this Mac, are sent only with the next request, and are cleared when you sign out."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금 말한 내용과 직접 고친 단어로 다음 받아쓰기를 더 정확하게 알아들어요. 기록은 이 Mac 안에만 남고, 다음 요청에만 함께 보내며, 로그아웃하면 지워져요."
          }
        }
      }
    },
    "settings.screenContext": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use visible screen terms (opt-in)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 용어 힌트 사용 (선택)"
          }
        }
      }
    },
    "settings.screenContext.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extracts proper nouns and English terms from the active window title and nearby text to improve spelling. Password fields are always skipped and nothing is logged."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 창 제목과 커서 주변 텍스트에서 고유명사·영문 용어만 추출해 철자 정확도를 높여요. 비밀번호 입력란은 항상 건너뛰며 기록하지 않아요."
          }
        }
      }
    },
