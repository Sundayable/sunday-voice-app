    "settings.proFeature.voiceBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free Local Mode transcribes cleanly on this Mac without an account. Sign in with Google under Account to learn your writing style from Gmail and Slack."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 로컬 모드는 로그인 없이 이 Mac에서 깔끔하게 받아써요. Gmail·Slack에서 내 말투를 학습하려면 계정 탭에서 Google로 로그인해 주세요."
          }
        }
      }
    },
    "settings.proFeature.voiceTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personal voice cards are a Pro feature"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 말투 학습은 Pro 기능이에요"
          }
        }
      }
    },
    "settings.proFeature.wordsBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free Local Mode uses on-device speech recognition and local replacements without an account. Sign in with Google under Account to sync personal terms from Gmail and Slack."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 로컬 모드는 로그인 없이 이 Mac의 로컬 음성 인식과 치환 사전을 사용해요. Gmail·Slack에서 내 단어를 가져오려면 계정 탭에서 Google로 로그인해 주세요."
          }
        }
      }
    },
    "settings.proFeature.wordsTitle": {
