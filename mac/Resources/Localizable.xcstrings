      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold your key and say: “Please confirm my appointment for tomorrow at three.” Your words land in the box below. You can also try Korean with your bilingual key."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 누른 채 “내일 오후 세 시에 예약 확인해 주세요.”라고 말해 보세요. 아래 칸에 바로 들어가요. 그다음 영어 키도 눌러 보세요."
          }
        }
      }
    },
    "ob.try.fallback": {
      "extractionState": "manual",
