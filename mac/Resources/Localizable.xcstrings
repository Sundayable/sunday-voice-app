    "setup.step2.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click into any text field, hold Control, say one sentence, then release."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무 입력 칸이나 클릭하고, Control을 누른 채 한 문장 말한 뒤 손을 떼세요."
          }
        }
      }
    },
