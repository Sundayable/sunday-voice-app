    "billing.pastDue.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update your payment method to resume cloud dictation, or switch to Free Local Mode in General."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제 수단을 업데이트하면 클라우드 받아쓰기가 다시 활성화됩니다. 일반 설정에서 무료 로컬 모드로 전환할 수도 있어요."
          }
        }
      }
    },
    "billing.pastDue.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment failed — Pro paused"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제 실패 — Pro 일시 중지"
          }
        }
      }
    },
    "billing.pro.activeBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud dictation (EN + KO), smart rewrite, and synced vocabulary are active."
