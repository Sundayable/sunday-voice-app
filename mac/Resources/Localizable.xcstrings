    "billing.upgrade.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock cloud dictation (EN + KO), real-time AI rewrite, Tidy, and synced vocabulary. Free Local Mode stays free forever."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초고속 클라우드 받아쓰기(영어·한국어), 실시간 AI 다듬기, Tidy, 단어장 동기화를 이용할 수 있어요. 무료 로컬 모드는 계속 무료입니다."
          }
        }
      }
    },
