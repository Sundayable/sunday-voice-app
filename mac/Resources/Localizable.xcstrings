    "vocab.import.consent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app can read the prompts you typed into AI assistants on this Mac (Claude Code today) and pick out the names and terms you use. Reading and counting happen on this Mac. You'll see the list before anything is sent."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 AI 도구에 직접 입력한 내용(지금은 Claude Code)을 읽어 자주 쓰는 이름과 용어를 골라요. 읽고 세는 일은 이 Mac 안에서만 해요. 보내기 전에 목록을 먼저 보여 드려요."
          }
        }
      }
    },
