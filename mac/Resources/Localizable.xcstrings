    "settings.account.localBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account needed. Your audio and text stay on this Mac, and nothing leaves your Mac unless you opt in to anonymous usage stats in General."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 필요 없어요. 음성과 텍스트는 이 Mac 안에만 머물며, 일반 설정에서 익명 사용 통계를 켜지 않는 한 어떤 데이터도 Mac 밖으로 나가지 않아요."
          }
